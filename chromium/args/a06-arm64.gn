# Development-only configuration for AOSP userdebug/eng or emulator testing.
target_os = "android"
target_cpu = "arm64"
is_debug = false
is_component_build = false
is_official_build = false
is_chrome_branded = false
use_official_google_api_keys = false
# The A06 is a low-end ARM64 device; avoid Chromium's high-end speed-for-memory profile.
is_high_end_android = false
system_webview_package_name = "com.android.webview"
