# Release configuration for a controlled AOSP-derived system image.
# The build script injects the external project-owned keystore settings locally.
target_os = "android"
target_cpu = "arm64"
is_debug = false
is_component_build = false
is_official_build = true
disable_fieldtrial_testing_config = true
android_channel = "stable"
is_chrome_branded = false
use_official_google_api_keys = false
system_webview_package_name = "io.github.astromg01.a06webcore"
